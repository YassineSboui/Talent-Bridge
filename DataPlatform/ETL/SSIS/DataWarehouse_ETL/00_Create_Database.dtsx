<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="4/16/2026 12:00:00 PM"
  DTS:CreatorComputerName="MEA-23VYXL3"
  DTS:CreatorName="YassineSBOUI"
  DTS:DTSID="{F1A20001-0001-4000-8000-000000000010}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="16.0.5397.1"
  DTS:LocaleID="1036"
  DTS:ObjectName="00_Create_Database"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{E2B30001-0001-4000-8000-000000000100}">
  <DTS:Property DTS:Name="PackageFormatVersion" DTS:DataType="6">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>

    <!-- ============================================================ -->
    <!-- TASK 1: Drop all existing objects + create schemas            -->
    <!-- Drops tables in FK-safe order, then creates all schemas      -->
    <!-- Fully idempotent - safe to re-run                            -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Reset_Schema"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Drop all tables in FK order, create schemas"
      DTS:DTSID="{A0000001-0001-4000-8000-100000000001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Reset_Schema"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;-- Drop all foreign keys first (safe order)&#xA;DECLARE @sql NVARCHAR(MAX) = N'';&#xA;SELECT @sql += N'ALTER TABLE ' + QUOTENAME(OBJECT_SCHEMA_NAME(parent_object_id))&#xA;    + N'.' + QUOTENAME(OBJECT_NAME(parent_object_id))&#xA;    + N' DROP CONSTRAINT ' + QUOTENAME(name) + N';' + NCHAR(10)&#xA;FROM sys.foreign_keys;&#xA;IF LEN(@sql) &gt; 0 EXEC sp_executesql @sql;&#xA;&#xA;-- Drop all tables in all DW schemas&#xA;DROP TABLE IF EXISTS bridge.job_schedule;&#xA;DROP TABLE IF EXISTS bridge.job_skill;&#xA;DROP TABLE IF EXISTS fact.job_posting;&#xA;DROP TABLE IF EXISTS dim.[date];&#xA;DROP TABLE IF EXISTS dim.company;&#xA;DROP TABLE IF EXISTS dim.[location];&#xA;DROP TABLE IF EXISTS dim.job_category;&#xA;DROP TABLE IF EXISTS dim.job_portal;&#xA;DROP TABLE IF EXISTS dim.schedule_type;&#xA;DROP TABLE IF EXISTS dim.skill;&#xA;DROP TABLE IF EXISTS dim.salary_rate;&#xA;DROP TABLE IF EXISTS staging.raw_import;&#xA;DROP TABLE IF EXISTS staging.job_postings;&#xA;DROP TABLE IF EXISTS staging.job_skills;&#xA;DROP TABLE IF EXISTS staging.job_schedule_types;&#xA;DROP TABLE IF EXISTS etl.run_log;&#xA;&#xA;-- Create schemas (idempotent)&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'staging') EXEC(N'CREATE SCHEMA staging');&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'dim')     EXEC(N'CREATE SCHEMA dim');&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'fact')    EXEC(N'CREATE SCHEMA fact');&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'bridge')  EXEC(N'CREATE SCHEMA bridge');&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'etl')     EXEC(N'CREATE SCHEMA etl');"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 2: Create all tables with optimal types, PKs + FKs      -->
    <!-- Star schema: staging -> dim -> fact -> bridge                 -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Create_All_Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create staging, dimension, fact, bridge, and ETL tables with constraints"
      DTS:DTSID="{A0000001-0001-4000-8000-100000000002}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Create_All_Tables"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;/* ========================= STAGING ========================= */&#xA;CREATE TABLE staging.job_postings (&#xA;    row_id             INT IDENTITY(1,1) NOT NULL,&#xA;    job_id             INT NOT NULL,&#xA;    job_title_short    NVARCHAR(100) NOT NULL,&#xA;    job_title          NVARCHAR(500) NULL,&#xA;    city               NVARCHAR(200) NULL,&#xA;    state_region       NVARCHAR(200) NULL,&#xA;    country            NVARCHAR(200) NULL,&#xA;    raw_location       NVARCHAR(500) NULL,&#xA;    job_portal         NVARCHAR(300) NULL,&#xA;    schedule_types     NVARCHAR(500) NULL,&#xA;    is_work_from_home  BIT NOT NULL DEFAULT 0,&#xA;    search_location    NVARCHAR(300) NULL,&#xA;    posted_date        DATETIME2 NULL,&#xA;    no_degree_mention  BIT NOT NULL DEFAULT 0,&#xA;    has_health_insurance BIT NOT NULL DEFAULT 0,&#xA;    salary_rate        VARCHAR(20) NULL,&#xA;    salary_year_avg    DECIMAL(12,2) NULL,&#xA;    salary_hour_avg    DECIMAL(10,2) NULL,&#xA;    company_name       NVARCHAR(300) NULL,&#xA;    CONSTRAINT PK_staging_job_postings PRIMARY KEY CLUSTERED (row_id)&#xA;);&#xA;&#xA;CREATE TABLE staging.job_skills (&#xA;    row_id          INT IDENTITY(1,1) NOT NULL,&#xA;    job_id          INT NOT NULL,&#xA;    skill_name      NVARCHAR(100) NOT NULL,&#xA;    skill_category  NVARCHAR(100) NULL,&#xA;    CONSTRAINT PK_staging_job_skills PRIMARY KEY CLUSTERED (row_id)&#xA;);&#xA;&#xA;CREATE TABLE staging.job_schedule_types (&#xA;    row_id              INT IDENTITY(1,1) NOT NULL,&#xA;    job_id              INT NOT NULL,&#xA;    schedule_type_name  NVARCHAR(100) NOT NULL,&#xA;    CONSTRAINT PK_staging_job_schedule PRIMARY KEY CLUSTERED (row_id)&#xA;);&#xA;&#xA;/* ======================== DIMENSIONS ======================== */&#xA;CREATE TABLE dim.[date] (&#xA;    date_key      INT NOT NULL,&#xA;    full_date     DATE NOT NULL,&#xA;    day_of_month  TINYINT NOT NULL,&#xA;    day_of_week   TINYINT NOT NULL,&#xA;    day_name      VARCHAR(10) NOT NULL,&#xA;    week_of_year  TINYINT NOT NULL,&#xA;    month_num     TINYINT NOT NULL,&#xA;    month_name    VARCHAR(10) NOT NULL,&#xA;    quarter       TINYINT NOT NULL,&#xA;    year          SMALLINT NOT NULL,&#xA;    is_weekend    BIT NOT NULL DEFAULT 0,&#xA;    CONSTRAINT PK_dim_date PRIMARY KEY CLUSTERED (date_key)&#xA;);&#xA;&#xA;CREATE TABLE dim.company (&#xA;    company_key   INT IDENTITY(1,1) NOT NULL,&#xA;    company_name  NVARCHAR(300) NOT NULL,&#xA;    CONSTRAINT PK_dim_company PRIMARY KEY CLUSTERED (company_key),&#xA;    CONSTRAINT UQ_dim_company UNIQUE (company_name)&#xA;);&#xA;&#xA;CREATE TABLE dim.[location] (&#xA;    location_key  INT IDENTITY(1,1) NOT NULL,&#xA;    raw_location  NVARCHAR(500) NULL,&#xA;    city          NVARCHAR(200) NULL,&#xA;    state_region  NVARCHAR(200) NULL,&#xA;    country       NVARCHAR(200) NOT NULL DEFAULT N'Unknown',&#xA;    CONSTRAINT PK_dim_location PRIMARY KEY CLUSTERED (location_key)&#xA;);&#xA;&#xA;CREATE TABLE dim.job_category (&#xA;    job_category_key  INT IDENTITY(1,1) NOT NULL,&#xA;    category_name     NVARCHAR(100) NOT NULL,&#xA;    CONSTRAINT PK_dim_job_category PRIMARY KEY CLUSTERED (job_category_key),&#xA;    CONSTRAINT UQ_dim_job_category UNIQUE (category_name)&#xA;);&#xA;&#xA;CREATE TABLE dim.job_portal (&#xA;    portal_key   INT IDENTITY(1,1) NOT NULL,&#xA;    portal_name  NVARCHAR(300) NOT NULL,&#xA;    CONSTRAINT PK_dim_job_portal PRIMARY KEY CLUSTERED (portal_key),&#xA;    CONSTRAINT UQ_dim_job_portal UNIQUE (portal_name)&#xA;);&#xA;&#xA;CREATE TABLE dim.schedule_type (&#xA;    schedule_type_key   INT IDENTITY(1,1) NOT NULL,&#xA;    schedule_type_name  NVARCHAR(100) NOT NULL,&#xA;    CONSTRAINT PK_dim_schedule_type PRIMARY KEY CLUSTERED (schedule_type_key),&#xA;    CONSTRAINT UQ_dim_schedule_type UNIQUE (schedule_type_name)&#xA;);&#xA;&#xA;CREATE TABLE dim.skill (&#xA;    skill_key       INT IDENTITY(1,1) NOT NULL,&#xA;    skill_name      NVARCHAR(100) NOT NULL,&#xA;    skill_category  NVARCHAR(100) NOT NULL DEFAULT N'other',&#xA;    CONSTRAINT PK_dim_skill PRIMARY KEY CLUSTERED (skill_key),&#xA;    CONSTRAINT UQ_dim_skill UNIQUE (skill_name, skill_category)&#xA;);&#xA;&#xA;CREATE TABLE dim.salary_rate (&#xA;    salary_rate_key  INT IDENTITY(1,1) NOT NULL,&#xA;    rate_name        VARCHAR(20) NOT NULL,&#xA;    CONSTRAINT PK_dim_salary_rate PRIMARY KEY CLUSTERED (salary_rate_key),&#xA;    CONSTRAINT UQ_dim_salary_rate UNIQUE (rate_name)&#xA;);&#xA;&#xA;/* ====================== FACT + BRIDGE ====================== */&#xA;CREATE TABLE fact.job_posting (&#xA;    job_posting_key     INT NOT NULL,&#xA;    date_key            INT NOT NULL,&#xA;    company_key         INT NOT NULL,&#xA;    location_key        INT NOT NULL,&#xA;    job_category_key    INT NOT NULL,&#xA;    portal_key          INT NOT NULL,&#xA;    salary_rate_key     INT NOT NULL,&#xA;    job_title           NVARCHAR(500) NULL,&#xA;    is_work_from_home   BIT NOT NULL DEFAULT 0,&#xA;    no_degree_mention   BIT NOT NULL DEFAULT 0,&#xA;    has_health_insurance BIT NOT NULL DEFAULT 0,&#xA;    salary_year_avg     DECIMAL(12,2) NULL,&#xA;    salary_hour_avg     DECIMAL(10,2) NULL,&#xA;    has_salary_info     BIT NOT NULL DEFAULT 0,&#xA;    CONSTRAINT PK_fact_job_posting PRIMARY KEY CLUSTERED (job_posting_key)&#xA;);&#xA;&#xA;CREATE TABLE bridge.job_skill (&#xA;    job_posting_key  INT NOT NULL,&#xA;    skill_key        INT NOT NULL,&#xA;    CONSTRAINT PK_bridge_job_skill PRIMARY KEY CLUSTERED (job_posting_key, skill_key)&#xA;);&#xA;&#xA;CREATE TABLE bridge.job_schedule (&#xA;    job_posting_key     INT NOT NULL,&#xA;    schedule_type_key   INT NOT NULL,&#xA;    CONSTRAINT PK_bridge_job_schedule PRIMARY KEY CLUSTERED (job_posting_key, schedule_type_key)&#xA;);&#xA;&#xA;/* ====================== FOREIGN KEYS ======================= */&#xA;ALTER TABLE fact.job_posting ADD CONSTRAINT FK_fact_date          FOREIGN KEY (date_key)         REFERENCES dim.[date](date_key);&#xA;ALTER TABLE fact.job_posting ADD CONSTRAINT FK_fact_company       FOREIGN KEY (company_key)      REFERENCES dim.company(company_key);&#xA;ALTER TABLE fact.job_posting ADD CONSTRAINT FK_fact_location      FOREIGN KEY (location_key)     REFERENCES dim.[location](location_key);&#xA;ALTER TABLE fact.job_posting ADD CONSTRAINT FK_fact_job_category  FOREIGN KEY (job_category_key) REFERENCES dim.job_category(job_category_key);&#xA;ALTER TABLE fact.job_posting ADD CONSTRAINT FK_fact_portal        FOREIGN KEY (portal_key)       REFERENCES dim.job_portal(portal_key);&#xA;ALTER TABLE fact.job_posting ADD CONSTRAINT FK_fact_salary_rate   FOREIGN KEY (salary_rate_key)  REFERENCES dim.salary_rate(salary_rate_key);&#xA;ALTER TABLE bridge.job_skill ADD CONSTRAINT FK_bridge_skill_job   FOREIGN KEY (job_posting_key)  REFERENCES fact.job_posting(job_posting_key);&#xA;ALTER TABLE bridge.job_skill ADD CONSTRAINT FK_bridge_skill_skill FOREIGN KEY (skill_key)        REFERENCES dim.skill(skill_key);&#xA;ALTER TABLE bridge.job_schedule ADD CONSTRAINT FK_bridge_sched_job  FOREIGN KEY (job_posting_key)   REFERENCES fact.job_posting(job_posting_key);&#xA;ALTER TABLE bridge.job_schedule ADD CONSTRAINT FK_bridge_sched_type FOREIGN KEY (schedule_type_key) REFERENCES dim.schedule_type(schedule_type_key);&#xA;&#xA;/* ======================== ETL AUDIT ========================= */&#xA;CREATE TABLE etl.run_log (&#xA;    run_id               INT IDENTITY(1,1) PRIMARY KEY,&#xA;    started_at           DATETIME2 NOT NULL,&#xA;    ended_at             DATETIME2 NULL,&#xA;    status               NVARCHAR(20) NOT NULL DEFAULT N'Running',&#xA;    duration_seconds     AS DATEDIFF(SECOND, started_at, ended_at),&#xA;    staging_rows         INT NULL,&#xA;    fact_rows            INT NULL,&#xA;    bridge_skill_rows    INT NULL,&#xA;    bridge_schedule_rows INT NULL,&#xA;    dim_count_summary    NVARCHAR(500) NULL&#xA;);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 3: Insert unknown member rows (-1 key) in all dims      -->
    <!-- Required for FK integrity when dimension lookup has no match  -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Insert_Unknown_Members"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Insert -1 unknown member rows in all dimension tables"
      DTS:DTSID="{A0000001-0001-4000-8000-100000000003}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Insert_Unknown_Members"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;-- dim.date: Unknown member&#xA;INSERT INTO dim.[date] (date_key, full_date, day_of_month, day_of_week, day_name, week_of_year, month_num, month_name, quarter, year, is_weekend)&#xA;VALUES (-1, '1900-01-01', 1, 1, 'Unknown', 1, 1, 'Unknown', 1, 1900, 0);&#xA;&#xA;-- dim.company: Unknown member&#xA;SET IDENTITY_INSERT dim.company ON;&#xA;INSERT INTO dim.company (company_key, company_name) VALUES (-1, N'Unknown');&#xA;SET IDENTITY_INSERT dim.company OFF;&#xA;&#xA;-- dim.location: Unknown member&#xA;SET IDENTITY_INSERT dim.[location] ON;&#xA;INSERT INTO dim.[location] (location_key, raw_location, city, state_region, country) VALUES (-1, N'Unknown', NULL, NULL, N'Unknown');&#xA;SET IDENTITY_INSERT dim.[location] OFF;&#xA;&#xA;-- dim.job_category: Unknown member&#xA;SET IDENTITY_INSERT dim.job_category ON;&#xA;INSERT INTO dim.job_category (job_category_key, category_name) VALUES (-1, N'Unknown');&#xA;SET IDENTITY_INSERT dim.job_category OFF;&#xA;&#xA;-- dim.job_portal: Unknown member&#xA;SET IDENTITY_INSERT dim.job_portal ON;&#xA;INSERT INTO dim.job_portal (portal_key, portal_name) VALUES (-1, N'Unknown');&#xA;SET IDENTITY_INSERT dim.job_portal OFF;&#xA;&#xA;-- dim.schedule_type: Unknown member&#xA;SET IDENTITY_INSERT dim.schedule_type ON;&#xA;INSERT INTO dim.schedule_type (schedule_type_key, schedule_type_name) VALUES (-1, N'Unknown');&#xA;SET IDENTITY_INSERT dim.schedule_type OFF;&#xA;&#xA;-- dim.skill: Unknown member&#xA;SET IDENTITY_INSERT dim.skill ON;&#xA;INSERT INTO dim.skill (skill_key, skill_name, skill_category) VALUES (-1, N'Unknown', N'unknown');&#xA;SET IDENTITY_INSERT dim.skill OFF;&#xA;&#xA;-- dim.salary_rate: Unknown member&#xA;SET IDENTITY_INSERT dim.salary_rate ON;&#xA;INSERT INTO dim.salary_rate (salary_rate_key, rate_name) VALUES (-1, 'Unknown');&#xA;SET IDENTITY_INSERT dim.salary_rate OFF;"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

  </DTS:Executables>

  <!-- FLOW: Reset -> Create -> Unknown Members -->
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Reset_to_Create]"
      DTS:CreationName=""
      DTS:DTSID="{D0000001-0001-4000-8000-200000000001}"
      DTS:From="Package\SQL_Reset_Schema"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Reset_to_Create"
      DTS:To="Package\SQL_Create_All_Tables" />
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Create_to_Unknown]"
      DTS:CreationName=""
      DTS:DTSID="{D0000001-0001-4000-8000-200000000002}"
      DTS:From="Package\SQL_Create_All_Tables"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Create_to_Unknown"
      DTS:To="Package\SQL_Insert_Unknown_Members" />
  </DTS:PrecedenceConstraints>

  <DTS:DesignTimeProperties><![CDATA[<?xml version="1.0"?>
<Objects Version="8">
  <Package design-time-name="Package">
    <LayoutInfo>
      <GraphLayout Capacity="4" NumberOfVisibleColumns="4" NumberOfColumns="4">
        <NodeLayout Size="230,42" Id="Package\SQL_Reset_Schema" TopLeft="275,30" />
        <NodeLayout Size="230,42" Id="Package\SQL_Create_All_Tables" TopLeft="275,120" />
        <NodeLayout Size="260,42" Id="Package\SQL_Insert_Unknown_Members" TopLeft="260,210" />
      </GraphLayout>
    </LayoutInfo>
  </Package>
</Objects>]]></DTS:DesignTimeProperties>

</DTS:Executable>
