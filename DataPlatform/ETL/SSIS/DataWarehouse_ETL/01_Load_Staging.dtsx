  DTS:ObjectName="01_Load_Staging"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="5"
  DTS:VersionGUID="{2638977F-2D1A-4F2C-9ACA-BEDD445DCDAC}">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL_BulkLoad_Raw"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Bulk load raw data_jobs.csv into staging.raw_import"
      DTS:DTSID="{A0010001-0001-4000-8000-100000000002}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_BulkLoad_Raw"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C0DE0001-DB01-4000-8000-000000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;BULK INSERT staging.raw_import&#xA;FROM 'd:\aaaz\Esprit\3AlT\Mession d''entreprise\Mission-D-entreprise\SSIS_DW\data\data_jobs.csv'&#xA;WITH (&#xA;    FORMAT = 'CSV',&#xA;    FIRSTROW = 2,&#xA;    FIELDTERMINATOR = ',',&#xA;    ROWTERMINATOR = '0x0a',&#xA;    TABLOCK,&#xA;    BATCHSIZE = 100000,&#xA;    MAXERRORS = 0&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Prepare_Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create raw_import table, truncate staging, drop NC indexes for fastest bulk load"
      DTS:DTSID="{A0010001-0001-4000-8000-100000000001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Prepare_Staging"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C0DE0001-DB01-4000-8000-000000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;-- Create raw import landing table (17 NVARCHAR cols matching CSV)&#xA;IF OBJECT_ID(N'staging.raw_import') IS NOT NULL DROP TABLE staging.raw_import;&#xA;CREATE TABLE staging.raw_import (&#xA;    job_title_short       NVARCHAR(500),&#xA;    job_title             NVARCHAR(1000),&#xA;    job_location          NVARCHAR(500),&#xA;    job_via               NVARCHAR(300),&#xA;    job_schedule_type     NVARCHAR(500),&#xA;    job_work_from_home    NVARCHAR(10),&#xA;    search_location       NVARCHAR(300),&#xA;    job_posted_date       NVARCHAR(50),&#xA;    job_no_degree_mention NVARCHAR(10),&#xA;    job_health_insurance  NVARCHAR(10),&#xA;    job_country           NVARCHAR(200),&#xA;    salary_rate           NVARCHAR(50),&#xA;    salary_year_avg       NVARCHAR(50),&#xA;    salary_hour_avg       NVARCHAR(50),&#xA;    company_name          NVARCHAR(1000),&#xA;    job_skills            NVARCHAR(MAX),&#xA;    job_type_skills       NVARCHAR(MAX)&#xA;);&#xA;&#xA;-- Dynamic drop of ALL nonclustered indexes on staging schema&#xA;DECLARE @sql NVARCHAR(MAX) = N'';&#xA;SELECT @sql += N'DROP INDEX ' + QUOTENAME(i.name) + N' ON '&#xA;    + QUOTENAME(SCHEMA_NAME(t.schema_id)) + N'.' + QUOTENAME(t.name) + N';' + NCHAR(10)&#xA;FROM sys.indexes i&#xA;INNER JOIN sys.tables t ON i.object_id = t.object_id&#xA;WHERE SCHEMA_NAME(t.schema_id) = N'staging'&#xA;  AND i.type = 2 AND i.is_primary_key = 0 AND i.is_unique_constraint = 0;&#xA;IF LEN(@sql) &gt; 0 EXEC sp_executesql @sql;&#xA;&#xA;-- Truncate all staging tables&#xA;TRUNCATE TABLE staging.job_schedule_types;&#xA;TRUNCATE TABLE staging.job_skills;&#xA;TRUNCATE TABLE staging.job_postings;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Rebuild_Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Drop raw_import, create staging indexes, update statistics"
      DTS:DTSID="{A0010001-0001-4000-8000-100000000005}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Rebuild_Staging"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C0DE0001-DB01-4000-8000-000000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID(N'staging.raw_import') IS NOT NULL DROP TABLE staging.raw_import;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = N'IX_stg_jobs_jobid')&#xA;    CREATE NONCLUSTERED INDEX IX_stg_jobs_jobid ON staging.job_postings (job_id)&#xA;    INCLUDE (job_title_short, company_name, raw_location, country, job_portal, salary_rate, posted_date)&#xA;    WITH (FILLFACTOR = 95);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = N'IX_stg_skills_jobid')&#xA;    CREATE NONCLUSTERED INDEX IX_stg_skills_jobid ON staging.job_skills (job_id)&#xA;    INCLUDE (skill_name, skill_category)&#xA;    WITH (FILLFACTOR = 95);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = N'IX_stg_schedules_jobid')&#xA;    CREATE NONCLUSTERED INDEX IX_stg_schedules_jobid ON staging.job_schedule_types (job_id)&#xA;    INCLUDE (schedule_type_name)&#xA;    WITH (FILLFACTOR = 95);&#xA;&#xA;UPDATE STATISTICS staging.job_postings WITH SAMPLE 50 PERCENT;&#xA;UPDATE STATISTICS staging.job_skills WITH SAMPLE 50 PERCENT;&#xA;UPDATE STATISTICS staging.job_schedule_types WITH SAMPLE 50 PERCENT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Transform_Jobs"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Transform raw_import into staging.job_postings with data cleaning"
      DTS:DTSID="{A0010001-0001-4000-8000-100000000010}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Transform_Jobs"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C0DE0001-DB01-4000-8000-000000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO staging.job_postings (&#xA;    job_id, job_title_short, job_title, city, state_region, country,&#xA;    raw_location, job_portal, schedule_types, is_work_from_home,&#xA;    search_location, posted_date, no_degree_mention, has_health_insurance,&#xA;    salary_rate, salary_year_avg, salary_hour_avg, company_name&#xA;)&#xA;SELECT&#xA;    ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS job_id,&#xA;    LEFT(LTRIM(RTRIM(ISNULL(job_title_short, N''))), 100),&#xA;    LEFT(LTRIM(RTRIM(job_title)), 500),&#xA;    CASE&#xA;        WHEN NULLIF(LTRIM(RTRIM(job_location)), N'') IS NULL THEN NULL&#xA;        WHEN LTRIM(RTRIM(job_location)) = N'Anywhere' THEN NULL&#xA;        WHEN CHARINDEX(N',', job_location) = 0 THEN LTRIM(RTRIM(job_location))&#xA;        ELSE LTRIM(RTRIM(LEFT(job_location, CHARINDEX(N',', job_location) - 1)))&#xA;    END,&#xA;    CASE&#xA;        WHEN NULLIF(LTRIM(RTRIM(job_location)), N'') IS NULL THEN NULL&#xA;        WHEN LTRIM(RTRIM(job_location)) = N'Anywhere' THEN NULL&#xA;        WHEN CHARINDEX(N',', job_location) = 0 THEN NULL&#xA;        ELSE LTRIM(RTRIM(STUFF(job_location, 1, CHARINDEX(N',', job_location), N'')))&#xA;    END,&#xA;    ISNULL(NULLIF(LTRIM(RTRIM(job_country)), N''), N'Unknown'),&#xA;    LTRIM(RTRIM(job_location)),&#xA;    CASE&#xA;        WHEN LTRIM(RTRIM(job_via)) LIKE N'via %' THEN LTRIM(RTRIM(SUBSTRING(job_via, 5, LEN(job_via))))&#xA;        ELSE NULLIF(LTRIM(RTRIM(job_via)), N'')&#xA;    END,&#xA;    LTRIM(RTRIM(job_schedule_type)),&#xA;    CASE WHEN UPPER(LTRIM(RTRIM(job_work_from_home))) = N'TRUE' THEN 1 ELSE 0 END,&#xA;    LTRIM(RTRIM(search_location)),&#xA;    TRY_CAST(LTRIM(RTRIM(job_posted_date)) AS DATETIME2),&#xA;    CASE WHEN UPPER(LTRIM(RTRIM(job_no_degree_mention))) = N'TRUE' THEN 1 ELSE 0 END,&#xA;    CASE WHEN UPPER(LTRIM(RTRIM(job_health_insurance))) = N'TRUE' THEN 1 ELSE 0 END,&#xA;    NULLIF(LTRIM(RTRIM(salary_rate)), N''),&#xA;    TRY_CAST(NULLIF(LTRIM(RTRIM(salary_year_avg)), N'') AS DECIMAL(12,2)),&#xA;    TRY_CAST(NULLIF(LTRIM(RTRIM(salary_hour_avg)), N'') AS DECIMAL(10,2)),&#xA;    LEFT(LTRIM(RTRIM(company_name)), 300)&#xA;FROM staging.raw_import;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Transform_Schedules"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Split schedule types into individual rows"
      DTS:DTSID="{A0010001-0001-4000-8000-100000000012}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Transform_Schedules"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C0DE0001-DB01-4000-8000-000000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;;WITH numbered AS (&#xA;    SELECT&#xA;        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS job_id,&#xA;        job_schedule_type&#xA;    FROM staging.raw_import&#xA;),&#xA;filtered AS (&#xA;    SELECT job_id, job_schedule_type&#xA;    FROM numbered&#xA;    WHERE NULLIF(LTRIM(RTRIM(job_schedule_type)), N'') IS NOT NULL&#xA;),&#xA;normalized AS (&#xA;    SELECT job_id,&#xA;           REPLACE(job_schedule_type, N' and ', N',') AS schedule_csv&#xA;    FROM filtered&#xA;)&#xA;INSERT INTO staging.job_schedule_types (job_id, schedule_type_name)&#xA;SELECT n.job_id,&#xA;       LTRIM(RTRIM(s.[value])) AS schedule_type_name&#xA;FROM normalized n&#xA;CROSS APPLY STRING_SPLIT(n.schedule_csv, N',') s&#xA;WHERE NULLIF(LTRIM(RTRIM(s.[value])), N'') IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Transform_Skills"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Parse job_type_skills Python dict and explode into skill rows"
      DTS:DTSID="{A0010001-0001-4000-8000-100000000011}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Transform_Skills"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C0DE0001-DB01-4000-8000-000000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;;WITH numbered AS (&#xA;    SELECT&#xA;        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS job_id,&#xA;        job_type_skills&#xA;    FROM staging.raw_import&#xA;),&#xA;filtered AS (&#xA;    SELECT job_id, job_type_skills&#xA;    FROM numbered&#xA;    WHERE NULLIF(LTRIM(RTRIM(job_type_skills)), N'') IS NOT NULL&#xA;),&#xA;as_json AS (&#xA;    SELECT job_id,&#xA;           REPLACE(job_type_skills, CHAR(39), CHAR(34)) AS jdoc&#xA;    FROM filtered&#xA;),&#xA;categories AS (&#xA;    SELECT j.job_id, cat.[key] AS skill_category, cat.[value] AS skill_array&#xA;    FROM as_json j&#xA;    CROSS APPLY OPENJSON(j.jdoc) cat&#xA;    WHERE ISJSON(j.jdoc) = 1&#xA;)&#xA;INSERT INTO staging.job_skills (job_id, skill_name, skill_category)&#xA;SELECT c.job_id,&#xA;       LTRIM(RTRIM(sk.[value])) AS skill_name,&#xA;       c.skill_category&#xA;FROM categories c&#xA;CROSS APPLY OPENJSON(c.skill_array) sk&#xA;WHERE NULLIF(LTRIM(RTRIM(sk.[value])), N'') IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Validate_Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Validate staging tables have data"
      DTS:DTSID="{A0010001-0001-4000-8000-100000000006}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Validate_Staging"
      DTS:TaskContact="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C0DE0001-DB01-4000-8000-000000000001}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @jobs INT, @skills INT, @schedules INT;&#xA;SELECT @jobs = COUNT(*) FROM staging.job_postings;&#xA;SELECT @skills = COUNT(*) FROM staging.job_skills;&#xA;SELECT @schedules = COUNT(*) FROM staging.job_schedule_types;&#xA;IF @jobs = 0 RAISERROR(N'STAGING VALIDATION FAILED: staging.job_postings is empty!', 16, 1);&#xA;IF @skills = 0 RAISERROR(N'STAGING VALIDATION FAILED: staging.job_skills is empty!', 16, 1);&#xA;IF @schedules = 0 RAISERROR(N'STAGING VALIDATION FAILED: staging.job_schedule_types is empty!', 16, 1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
