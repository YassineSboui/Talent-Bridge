<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="4/16/2026 12:00:00 PM"
  DTS:CreatorComputerName="MEA-23VYXL3"
  DTS:CreatorName="YassineSBOUI"
  DTS:DTSID="{F1A20001-0001-4000-8000-000000000001}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="16.0.5397.1"
  DTS:LocaleID="1036"
  DTS:ObjectName="Master"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="3"
  DTS:VersionGUID="{E2B30001-0001-4000-8000-000000000031}">
  <DTS:Property DTS:Name="PackageFormatVersion" DTS:DataType="6">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>

    <!-- ============================================================ -->
    <!-- STEP 0: ETL Start - create audit log + record start time     -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_ETL_Start"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create ETL audit log if needed and record run start"
      DTS:DTSID="{A0050001-0001-4000-8000-100000000000}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_ETL_Start"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;-- etl.run_log is created by 00_Create_Database; just insert start record&#xA;IF OBJECT_ID(N'etl.run_log') IS NOT NULL&#xA;    INSERT INTO etl.run_log (started_at, status) VALUES (GETDATE(), N'Running');"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- STEP 1: Create/reset database schema                         -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\EPT_00_Create_Database"
      DTS:CreationName="Microsoft.ExecutePackageTask"
      DTS:Description="Drop/recreate all schemas, tables, FKs, unknown members"
      DTS:DTSID="{A0050001-0001-4000-8000-100000000010}"
      DTS:ExecutableType="Microsoft.ExecutePackageTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT_00_Create_Database">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExecutePackageTask>
          <UseProjectReference>True</UseProjectReference>
          <PackageName>00_Create_Database.dtsx</PackageName>
        </ExecutePackageTask>
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- STEP 2: Load staging from raw CSV                            -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\EPT_01_Load_Staging"
      DTS:CreationName="Microsoft.ExecutePackageTask"
      DTS:Description="BULK INSERT raw CSV, transform/clean, split into 3 staging tables"
      DTS:DTSID="{A0050001-0001-4000-8000-100000000001}"
      DTS:ExecutableType="Microsoft.ExecutePackageTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT_01_Load_Staging">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExecutePackageTask>
          <UseProjectReference>True</UseProjectReference>
          <PackageName>01_Load_Staging.dtsx</PackageName>
        </ExecutePackageTask>
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- STEP 3: Populate dimensions                                  -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\EPT_02_Populate_Dimensions"
      DTS:CreationName="Microsoft.ExecutePackageTask"
      DTS:Description="Populate 8 dimensions in parallel from staging"
      DTS:DTSID="{A0050001-0001-4000-8000-100000000002}"
      DTS:ExecutableType="Microsoft.ExecutePackageTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT_02_Populate_Dimensions">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExecutePackageTask>
          <UseProjectReference>True</UseProjectReference>
          <PackageName>02_Populate_Dimensions.dtsx</PackageName>
        </ExecutePackageTask>
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- STEP 4: Populate fact + bridge tables                        -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\EPT_03_Populate_Facts"
      DTS:CreationName="Microsoft.ExecutePackageTask"
      DTS:Description="Load fact.job_posting + parallel bridge tables with TABLOCK"
      DTS:DTSID="{A0050001-0001-4000-8000-100000000003}"
      DTS:ExecutableType="Microsoft.ExecutePackageTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT_03_Populate_Facts">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExecutePackageTask>
          <UseProjectReference>True</UseProjectReference>
          <PackageName>03_Populate_Facts.dtsx</PackageName>
        </ExecutePackageTask>
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- STEP 5: Finalize (indexes + stats + validation)              -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\EPT_04_Finalize"
      DTS:CreationName="Microsoft.ExecutePackageTask"
      DTS:Description="Build indexes with PAGE compression + update stats + FK validation"
      DTS:DTSID="{A0050001-0001-4000-8000-100000000004}"
      DTS:ExecutableType="Microsoft.ExecutePackageTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT_04_Finalize">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExecutePackageTask>
          <UseProjectReference>True</UseProjectReference>
          <PackageName>04_Finalize.dtsx</PackageName>
        </ExecutePackageTask>
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- STEP 6: ETL Complete - record end time + row counts          -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_ETL_Complete"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Record ETL completion with row counts in audit log"
      DTS:DTSID="{A0050001-0001-4000-8000-100000000005}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_ETL_Complete"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @f INT, @bs INT, @bsc INT, @stg INT;&#xA;SELECT @stg = COUNT(*) FROM staging.job_postings;&#xA;SELECT @f = COUNT(*) FROM fact.job_posting;&#xA;SELECT @bs = COUNT(*) FROM bridge.job_skill;&#xA;SELECT @bsc = COUNT(*) FROM bridge.job_schedule;&#xA;UPDATE etl.run_log&#xA;SET ended_at = GETDATE(),&#xA;    status = N'Completed',&#xA;    staging_rows = @stg,&#xA;    fact_rows = @f,&#xA;    bridge_skill_rows = @bs,&#xA;    bridge_schedule_rows = @bsc,&#xA;    dim_count_summary = (&#xA;        SELECT CONCAT(&#xA;            N'date:', (SELECT COUNT(*) FROM dim.[date] WHERE date_key &gt; 0),&#xA;            N' company:', (SELECT COUNT(*) FROM dim.company WHERE company_key &gt; 0),&#xA;            N' location:', (SELECT COUNT(*) FROM dim.[location] WHERE location_key &gt; 0),&#xA;            N' category:', (SELECT COUNT(*) FROM dim.job_category WHERE job_category_key &gt; 0),&#xA;            N' portal:', (SELECT COUNT(*) FROM dim.job_portal WHERE portal_key &gt; 0),&#xA;            N' skill:', (SELECT COUNT(*) FROM dim.skill WHERE skill_key &gt; 0),&#xA;            N' salary_rate:', (SELECT COUNT(*) FROM dim.salary_rate WHERE salary_rate_key &gt; 0),&#xA;            N' schedule:', (SELECT COUNT(*) FROM dim.schedule_type WHERE schedule_type_key &gt; 0)&#xA;        )&#xA;    )&#xA;WHERE run_id = (SELECT MAX(run_id) FROM etl.run_log WHERE status = N'Running');"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

  </DTS:Executables>

  <!-- FLOW: ETLStart -> 00_Create -> 01_Staging -> 02_Dims -> 03_Facts -> 04_Finalize -> ETLComplete -->
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Start_to_Create]" DTS:CreationName="" DTS:DTSID="{D0050001-0001-4000-8000-200000000010}" DTS:From="Package\SQL_ETL_Start" DTS:LogicalAnd="True" DTS:ObjectName="Start_to_Create" DTS:To="Package\EPT_00_Create_Database" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Create_to_Staging]" DTS:CreationName="" DTS:DTSID="{D0050001-0001-4000-8000-200000000000}" DTS:From="Package\EPT_00_Create_Database" DTS:LogicalAnd="True" DTS:ObjectName="Create_to_Staging" DTS:To="Package\EPT_01_Load_Staging" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Staging_to_Dims]" DTS:CreationName="" DTS:DTSID="{D0050001-0001-4000-8000-200000000001}" DTS:From="Package\EPT_01_Load_Staging" DTS:LogicalAnd="True" DTS:ObjectName="Staging_to_Dims" DTS:To="Package\EPT_02_Populate_Dimensions" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Dims_to_Facts]" DTS:CreationName="" DTS:DTSID="{D0050001-0001-4000-8000-200000000002}" DTS:From="Package\EPT_02_Populate_Dimensions" DTS:LogicalAnd="True" DTS:ObjectName="Dims_to_Facts" DTS:To="Package\EPT_03_Populate_Facts" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Facts_to_Finalize]" DTS:CreationName="" DTS:DTSID="{D0050001-0001-4000-8000-200000000003}" DTS:From="Package\EPT_03_Populate_Facts" DTS:LogicalAnd="True" DTS:ObjectName="Facts_to_Finalize" DTS:To="Package\EPT_04_Finalize" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Finalize_to_Complete]" DTS:CreationName="" DTS:DTSID="{D0050001-0001-4000-8000-200000000004}" DTS:From="Package\EPT_04_Finalize" DTS:LogicalAnd="True" DTS:ObjectName="Finalize_to_Complete" DTS:To="Package\SQL_ETL_Complete" />
  </DTS:PrecedenceConstraints>

