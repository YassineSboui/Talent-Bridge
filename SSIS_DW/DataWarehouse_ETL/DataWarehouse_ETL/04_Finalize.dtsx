<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="4/16/2026 12:00:00 PM"
  DTS:CreatorComputerName="MEA-23VYXL3"
  DTS:CreatorName="YassineSBOUI"
  DTS:DTSID="{F1A20001-0001-4000-8000-000000000005}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="16.0.5397.1"
  DTS:LocaleID="1036"
  DTS:ObjectName="04_Finalize"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="3"
  DTS:VersionGUID="{E2B30001-0001-4000-8000-000000000035}">
  <DTS:Property DTS:Name="PackageFormatVersion" DTS:DataType="6">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>

    <!-- ============================================================ -->
    <!-- TASK 1a: FACT indexes (PARALLEL) - PAGE compression, FILLFACTOR=90 -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Indexes_Fact"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create fact table nonclustered indexes with PAGE compression"
      DTS:DTSID="{A0040001-0001-4000-8000-100000000001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Indexes_Fact"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_fact_job_date')&#xA;    CREATE NONCLUSTERED INDEX IX_fact_job_date ON fact.job_posting (date_key)&#xA;    INCLUDE (company_key, location_key, job_category_key, salary_year_avg)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_fact_job_category')&#xA;    CREATE NONCLUSTERED INDEX IX_fact_job_category ON fact.job_posting (job_category_key)&#xA;    INCLUDE (date_key, salary_year_avg, salary_hour_avg, has_salary_info)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_fact_job_company')&#xA;    CREATE NONCLUSTERED INDEX IX_fact_job_company ON fact.job_posting (company_key)&#xA;    INCLUDE (job_category_key, location_key, salary_year_avg)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_fact_job_location')&#xA;    CREATE NONCLUSTERED INDEX IX_fact_job_location ON fact.job_posting (location_key)&#xA;    INCLUDE (job_category_key, salary_year_avg, is_work_from_home)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_fact_job_salary')&#xA;    CREATE NONCLUSTERED INDEX IX_fact_job_salary ON fact.job_posting (has_salary_info, salary_rate_key)&#xA;    INCLUDE (salary_year_avg, salary_hour_avg, job_category_key)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_fact_job_wfh')&#xA;    CREATE NONCLUSTERED INDEX IX_fact_job_wfh ON fact.job_posting (is_work_from_home)&#xA;    INCLUDE (job_category_key, location_key, date_key)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_fact_job_portal')&#xA;    CREATE NONCLUSTERED INDEX IX_fact_job_portal ON fact.job_posting (portal_key)&#xA;    INCLUDE (job_category_key, date_key)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 1b: BRIDGE indexes (PARALLEL)                            -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Indexes_Bridge"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create bridge table nonclustered indexes with PAGE compression"
      DTS:DTSID="{A0040001-0001-4000-8000-100000000002}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Indexes_Bridge"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_bridge_skill_skillkey')&#xA;    CREATE NONCLUSTERED INDEX IX_bridge_skill_skillkey ON bridge.job_skill (skill_key)&#xA;    INCLUDE (job_posting_key)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_bridge_skill_jobkey')&#xA;    CREATE NONCLUSTERED INDEX IX_bridge_skill_jobkey ON bridge.job_skill (job_posting_key)&#xA;    INCLUDE (skill_key)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_bridge_schedule_typekey')&#xA;    CREATE NONCLUSTERED INDEX IX_bridge_schedule_typekey ON bridge.job_schedule (schedule_type_key)&#xA;    INCLUDE (job_posting_key)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_bridge_schedule_jobkey')&#xA;    CREATE NONCLUSTERED INDEX IX_bridge_schedule_jobkey ON bridge.job_schedule (job_posting_key)&#xA;    INCLUDE (schedule_type_key)&#xA;    WITH (FILLFACTOR=90, DATA_COMPRESSION=PAGE, SORT_IN_TEMPDB=ON);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 1c: DIM indexes (PARALLEL)                               -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Indexes_Dim"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create dimension table nonclustered indexes"
      DTS:DTSID="{A0040001-0001-4000-8000-100000000003}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Indexes_Dim"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_dim_location_country')&#xA;    CREATE NONCLUSTERED INDEX IX_dim_location_country ON dim.[location] (country)&#xA;    INCLUDE (city, state_region) WITH (FILLFACTOR=90);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_dim_skill_category')&#xA;    CREATE NONCLUSTERED INDEX IX_dim_skill_category ON dim.skill (skill_category)&#xA;    INCLUDE (skill_name) WITH (FILLFACTOR=90);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_dim_company_name')&#xA;    CREATE NONCLUSTERED INDEX IX_dim_company_name ON dim.company (company_name)&#xA;    WITH (FILLFACTOR=90);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name=N'IX_dim_date_year_month')&#xA;    CREATE NONCLUSTERED INDEX IX_dim_date_year_month ON dim.[date] (year, month_num)&#xA;    INCLUDE (quarter, is_weekend) WITH (FILLFACTOR=95);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 2: Update statistics globally                            -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Update_Stats"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Update statistics on all DW tables"
      DTS:DTSID="{A0040001-0001-4000-8000-100000000004}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Update_Stats"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;EXEC sp_updatestats;"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 3: Full FK integrity + orphan row audit                   -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Final_Validation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Full FK integrity check - detect orphan rows across all joins"
      DTS:DTSID="{A0040001-0001-4000-8000-100000000005}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Final_Validation"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @orphans INT = 0;&#xA;-- Fact -> Dim checks (skip -1 unknown members)&#xA;SELECT @orphans = @orphans + COUNT(*) FROM fact.job_posting f WHERE f.date_key &lt;&gt; -1 AND NOT EXISTS (SELECT 1 FROM dim.[date] d WHERE d.date_key = f.date_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM fact.job_posting f WHERE f.company_key &lt;&gt; -1 AND NOT EXISTS (SELECT 1 FROM dim.company c WHERE c.company_key = f.company_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM fact.job_posting f WHERE f.location_key &lt;&gt; -1 AND NOT EXISTS (SELECT 1 FROM dim.[location] l WHERE l.location_key = f.location_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM fact.job_posting f WHERE f.job_category_key &lt;&gt; -1 AND NOT EXISTS (SELECT 1 FROM dim.job_category jc WHERE jc.job_category_key = f.job_category_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM fact.job_posting f WHERE f.portal_key &lt;&gt; -1 AND NOT EXISTS (SELECT 1 FROM dim.job_portal p WHERE p.portal_key = f.portal_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM fact.job_posting f WHERE f.salary_rate_key &lt;&gt; -1 AND NOT EXISTS (SELECT 1 FROM dim.salary_rate sr WHERE sr.salary_rate_key = f.salary_rate_key);&#xA;-- Bridge -> Fact/Dim checks&#xA;SELECT @orphans = @orphans + COUNT(*) FROM bridge.job_skill bs WHERE NOT EXISTS (SELECT 1 FROM fact.job_posting f WHERE f.job_posting_key = bs.job_posting_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM bridge.job_skill bs WHERE NOT EXISTS (SELECT 1 FROM dim.skill sk WHERE sk.skill_key = bs.skill_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM bridge.job_schedule bs WHERE NOT EXISTS (SELECT 1 FROM fact.job_posting f WHERE f.job_posting_key = bs.job_posting_key);&#xA;SELECT @orphans = @orphans + COUNT(*) FROM bridge.job_schedule bs WHERE NOT EXISTS (SELECT 1 FROM dim.schedule_type st WHERE st.schedule_type_key = bs.schedule_type_key);&#xA;IF @orphans &gt; 0 RAISERROR(N'FK INTEGRITY CHECK FAILED: %d orphan rows found!', 16, 1, @orphans);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

  </DTS:Executables>

  <!-- FLOW: [FactIdx || BridgeIdx || DimIdx] parallel -> UpdateStats -> Validation -->
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[FactIdx_to_Stats]" DTS:CreationName="" DTS:DTSID="{D0040001-0001-4000-8000-200000000001}" DTS:From="Package\SQL_Indexes_Fact" DTS:LogicalAnd="True" DTS:ObjectName="FactIdx_to_Stats" DTS:To="Package\SQL_Update_Stats" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[BridgeIdx_to_Stats]" DTS:CreationName="" DTS:DTSID="{D0040001-0001-4000-8000-200000000002}" DTS:From="Package\SQL_Indexes_Bridge" DTS:LogicalAnd="True" DTS:ObjectName="BridgeIdx_to_Stats" DTS:To="Package\SQL_Update_Stats" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[DimIdx_to_Stats]" DTS:CreationName="" DTS:DTSID="{D0040001-0001-4000-8000-200000000003}" DTS:From="Package\SQL_Indexes_Dim" DTS:LogicalAnd="True" DTS:ObjectName="DimIdx_to_Stats" DTS:To="Package\SQL_Update_Stats" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Stats_to_Validation]" DTS:CreationName="" DTS:DTSID="{D0040001-0001-4000-8000-200000000004}" DTS:From="Package\SQL_Update_Stats" DTS:LogicalAnd="True" DTS:ObjectName="Stats_to_Validation" DTS:To="Package\SQL_Final_Validation" />
  </DTS:PrecedenceConstraints>

  <DTS:DesignTimeProperties><![CDATA[<?xml version="1.0"?>
<Objects Version="8">
  <Package design-time-name="Package">
    <LayoutInfo>
      <GraphLayout Capacity="8" NumberOfVisibleColumns="4" NumberOfColumns="4">
        <NodeLayout Size="220,42" Id="Package\SQL_Indexes_Fact" TopLeft="50,30" />
        <NodeLayout Size="220,42" Id="Package\SQL_Indexes_Bridge" TopLeft="290,30" />
        <NodeLayout Size="220,42" Id="Package\SQL_Indexes_Dim" TopLeft="530,30" />
        <NodeLayout Size="220,42" Id="Package\SQL_Update_Stats" TopLeft="290,130" />
        <NodeLayout Size="220,42" Id="Package\SQL_Final_Validation" TopLeft="290,220" />
      </GraphLayout>
    </LayoutInfo>
  </Package>
</Objects>]]></DTS:DesignTimeProperties>

</DTS:Executable>
