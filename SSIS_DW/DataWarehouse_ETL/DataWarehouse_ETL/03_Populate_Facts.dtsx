<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="4/16/2026 12:00:00 PM"
  DTS:CreatorComputerName="MEA-23VYXL3"
  DTS:CreatorName="YassineSBOUI"
  DTS:DTSID="{F1A20001-0001-4000-8000-000000000004}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="16.0.5397.1"
  DTS:LocaleID="1036"
  DTS:ObjectName="03_Populate_Facts"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="3"
  DTS:VersionGUID="{E2B30001-0001-4000-8000-000000000034}">
  <DTS:Property DTS:Name="PackageFormatVersion" DTS:DataType="6">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>

    <!-- ============================================================ -->
    <!-- TASK 1: NOCHECK FKs + TRUNCATE fact/bridge + drop NC indexes -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Prepare_Targets"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Disable FKs, truncate fact/bridge, drop NC indexes for fastest load"
      DTS:DTSID="{A0030001-0001-4000-8000-100000000001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Prepare_Targets"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;-- Drop bridge FKs that reference fact (required for TRUNCATE)&#xA;IF OBJECT_ID(N'bridge.FK_bridge_skill_job', N'F') IS NOT NULL ALTER TABLE bridge.job_skill DROP CONSTRAINT FK_bridge_skill_job;&#xA;IF OBJECT_ID(N'bridge.FK_bridge_sched_job', N'F') IS NOT NULL ALTER TABLE bridge.job_schedule DROP CONSTRAINT FK_bridge_sched_job;&#xA;-- Disable remaining FK constraints&#xA;ALTER TABLE bridge.job_skill NOCHECK CONSTRAINT ALL;&#xA;ALTER TABLE bridge.job_schedule NOCHECK CONSTRAINT ALL;&#xA;ALTER TABLE fact.job_posting NOCHECK CONSTRAINT ALL;&#xA;-- TRUNCATE (instant, minimal logging)&#xA;TRUNCATE TABLE bridge.job_schedule;&#xA;TRUNCATE TABLE bridge.job_skill;&#xA;TRUNCATE TABLE fact.job_posting;&#xA;-- Drop NC indexes on fact/bridge (rebuilt in 04_Finalize)&#xA;DECLARE @sql NVARCHAR(MAX) = N'';&#xA;SELECT @sql += N'DROP INDEX ' + QUOTENAME(i.name) + N' ON '&#xA;    + QUOTENAME(SCHEMA_NAME(t.schema_id)) + N'.' + QUOTENAME(t.name) + N';' + NCHAR(10)&#xA;FROM sys.indexes i&#xA;INNER JOIN sys.tables t ON i.object_id = t.object_id&#xA;WHERE SCHEMA_NAME(t.schema_id) IN (N'fact', N'bridge')&#xA;  AND i.type = 2 AND i.is_primary_key = 0 AND i.is_unique_constraint = 0;&#xA;IF LEN(@sql) &gt; 0 EXEC sp_executesql @sql;"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 2: Populate fact.job_posting (TABLOCK = minimal logging) -->
    <!-- LEFT JOINs to all dims, ISNULL(key, -1) for unknown members  -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Fact_JobPosting"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Insert fact rows with dimension lookups and TABLOCK"
      DTS:DTSID="{A0030001-0001-4000-8000-100000000002}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Fact_JobPosting"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO fact.job_posting WITH (TABLOCK) (&#xA;    job_posting_key, date_key, company_key, location_key,&#xA;    job_category_key, portal_key, salary_rate_key,&#xA;    job_title, is_work_from_home, no_degree_mention,&#xA;    has_health_insurance, salary_year_avg, salary_hour_avg, has_salary_info&#xA;)&#xA;SELECT&#xA;    s.job_id,&#xA;    ISNULL(d.date_key, -1),&#xA;    ISNULL(c.company_key, -1),&#xA;    ISNULL(l.location_key, -1),&#xA;    ISNULL(jc.job_category_key, -1),&#xA;    ISNULL(p.portal_key, -1),&#xA;    ISNULL(sr.salary_rate_key, -1),&#xA;    s.job_title,&#xA;    s.is_work_from_home,&#xA;    s.no_degree_mention,&#xA;    s.has_health_insurance,&#xA;    s.salary_year_avg,&#xA;    s.salary_hour_avg,&#xA;    CASE WHEN s.salary_year_avg IS NOT NULL OR s.salary_hour_avg IS NOT NULL THEN 1 ELSE 0 END&#xA;FROM staging.job_postings s&#xA;LEFT JOIN dim.[date] d&#xA;    ON d.date_key = CAST(FORMAT(CAST(s.posted_date AS DATE), 'yyyyMMdd') AS INT)&#xA;LEFT JOIN dim.company c&#xA;    ON c.company_name = ISNULL(NULLIF(LTRIM(RTRIM(s.company_name)), N''), N'Unknown')&#xA;LEFT JOIN (&#xA;    SELECT raw_location, country, MIN(location_key) AS location_key&#xA;    FROM dim.[location] WHERE location_key &gt; 0&#xA;    GROUP BY raw_location, country&#xA;) l&#xA;    ON ISNULL(l.raw_location, N'') = ISNULL(s.raw_location, N'')&#xA;    AND l.country = ISNULL(NULLIF(LTRIM(RTRIM(s.country)), N''), N'Unknown')&#xA;LEFT JOIN dim.job_category jc&#xA;    ON jc.category_name = LTRIM(RTRIM(s.job_title_short))&#xA;LEFT JOIN dim.job_portal p&#xA;    ON p.portal_name = ISNULL(NULLIF(LTRIM(RTRIM(s.job_portal)), N''), N'Unknown')&#xA;LEFT JOIN dim.salary_rate sr&#xA;    ON sr.rate_name = CASE&#xA;        WHEN s.salary_rate IS NULL OR LTRIM(RTRIM(s.salary_rate)) = '' THEN 'Unknown'&#xA;        ELSE LTRIM(RTRIM(s.salary_rate)) END;"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 3a: bridge.job_skill (PARALLEL with schedule bridge)     -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Bridge_Skill"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Populate job-skill bridge with TABLOCK"
      DTS:DTSID="{A0030001-0001-4000-8000-100000000003}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Bridge_Skill"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;INSERT INTO bridge.job_skill WITH (TABLOCK) (job_posting_key, skill_key)&#xA;SELECT DISTINCT ss.job_id, sk.skill_key&#xA;FROM staging.job_skills ss&#xA;INNER JOIN dim.skill sk&#xA;    ON sk.skill_name = LTRIM(RTRIM(ss.skill_name))&#xA;    AND sk.skill_category = ISNULL(NULLIF(LTRIM(RTRIM(ss.skill_category)), N''), N'other')&#xA;WHERE EXISTS (SELECT 1 FROM fact.job_posting f WHERE f.job_posting_key = ss.job_id);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 3b: bridge.job_schedule (PARALLEL with skill bridge)     -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Bridge_Schedule"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Populate job-schedule bridge with TABLOCK"
      DTS:DTSID="{A0030001-0001-4000-8000-100000000004}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Bridge_Schedule"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;INSERT INTO bridge.job_schedule WITH (TABLOCK) (job_posting_key, schedule_type_key)&#xA;SELECT DISTINCT sst.job_id, st.schedule_type_key&#xA;FROM staging.job_schedule_types sst&#xA;INNER JOIN dim.schedule_type st&#xA;    ON st.schedule_type_name = LTRIM(RTRIM(sst.schedule_type_name))&#xA;WHERE EXISTS (SELECT 1 FROM fact.job_posting f WHERE f.job_posting_key = sst.job_id);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ============================================================ -->
    <!-- TASK 4: Re-enable FKs WITH CHECK + validate counts            -->
    <!-- ============================================================ -->
    <DTS:Executable
      DTS:refId="Package\SQL_Enable_FK_Validate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Re-enable FK constraints with CHECK and validate row counts"
      DTS:DTSID="{A0030001-0001-4000-8000-100000000005}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Enable_FK_Validate"
      DTS:TaskContact="Execute SQL Task">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="DW_DataJobs"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;-- Recreate bridge->fact FKs that were dropped in Prepare step&#xA;IF NOT EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = N'FK_bridge_skill_job')&#xA;    ALTER TABLE bridge.job_skill ADD CONSTRAINT FK_bridge_skill_job FOREIGN KEY (job_posting_key) REFERENCES fact.job_posting(job_posting_key);&#xA;IF NOT EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = N'FK_bridge_sched_job')&#xA;    ALTER TABLE bridge.job_schedule ADD CONSTRAINT FK_bridge_sched_job FOREIGN KEY (job_posting_key) REFERENCES fact.job_posting(job_posting_key);&#xA;-- Re-enable and validate FK constraints (marks as trusted)&#xA;ALTER TABLE fact.job_posting WITH CHECK CHECK CONSTRAINT ALL;&#xA;ALTER TABLE bridge.job_skill WITH CHECK CHECK CONSTRAINT ALL;&#xA;ALTER TABLE bridge.job_schedule WITH CHECK CHECK CONSTRAINT ALL;&#xA;-- Validate&#xA;DECLARE @f INT, @bs INT, @bsc INT;&#xA;SELECT @f = COUNT(*) FROM fact.job_posting;&#xA;SELECT @bs = COUNT(*) FROM bridge.job_skill;&#xA;SELECT @bsc = COUNT(*) FROM bridge.job_schedule;&#xA;IF @f = 0 RAISERROR(N'FACT VALIDATION FAILED: fact.job_posting is empty!', 16, 1);&#xA;IF @bs = 0 RAISERROR(N'BRIDGE VALIDATION FAILED: bridge.job_skill is empty!', 16, 1);&#xA;IF @bsc = 0 RAISERROR(N'BRIDGE VALIDATION FAILED: bridge.job_schedule is empty!', 16, 1);"
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

  </DTS:Executables>

  <!-- FLOW: Prepare -> Fact -> [BridgeSkill || BridgeSchedule] -> EnableFK+Validate -->
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Prepare_to_Fact]" DTS:CreationName="" DTS:DTSID="{D0030001-0001-4000-8000-200000000001}" DTS:From="Package\SQL_Prepare_Targets" DTS:LogicalAnd="True" DTS:ObjectName="Prepare_to_Fact" DTS:To="Package\SQL_Fact_JobPosting" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Fact_to_BridgeSkill]" DTS:CreationName="" DTS:DTSID="{D0030001-0001-4000-8000-200000000002}" DTS:From="Package\SQL_Fact_JobPosting" DTS:LogicalAnd="True" DTS:ObjectName="Fact_to_BridgeSkill" DTS:To="Package\SQL_Bridge_Skill" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Fact_to_BridgeSchedule]" DTS:CreationName="" DTS:DTSID="{D0030001-0001-4000-8000-200000000003}" DTS:From="Package\SQL_Fact_JobPosting" DTS:LogicalAnd="True" DTS:ObjectName="Fact_to_BridgeSchedule" DTS:To="Package\SQL_Bridge_Schedule" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[BridgeSkill_to_Validate]" DTS:CreationName="" DTS:DTSID="{D0030001-0001-4000-8000-200000000004}" DTS:From="Package\SQL_Bridge_Skill" DTS:LogicalAnd="True" DTS:ObjectName="BridgeSkill_to_Validate" DTS:To="Package\SQL_Enable_FK_Validate" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[BridgeSchedule_to_Validate]" DTS:CreationName="" DTS:DTSID="{D0030001-0001-4000-8000-200000000005}" DTS:From="Package\SQL_Bridge_Schedule" DTS:LogicalAnd="True" DTS:ObjectName="BridgeSchedule_to_Validate" DTS:To="Package\SQL_Enable_FK_Validate" />
  </DTS:PrecedenceConstraints>

  <DTS:DesignTimeProperties><![CDATA[<?xml version="1.0"?>
<Objects Version="8">
  <Package design-time-name="Package">
    <LayoutInfo>
      <GraphLayout Capacity="8" NumberOfVisibleColumns="4" NumberOfColumns="4">
        <NodeLayout Size="230,42" Id="Package\SQL_Prepare_Targets" TopLeft="275,20" />
        <NodeLayout Size="230,42" Id="Package\SQL_Fact_JobPosting" TopLeft="275,100" />
        <NodeLayout Size="230,42" Id="Package\SQL_Bridge_Skill" TopLeft="120,200" />
        <NodeLayout Size="230,42" Id="Package\SQL_Bridge_Schedule" TopLeft="430,200" />
        <NodeLayout Size="260,42" Id="Package\SQL_Enable_FK_Validate" TopLeft="265,300" />
      </GraphLayout>
    </LayoutInfo>
  </Package>
</Objects>]]></DTS:DesignTimeProperties>

</DTS:Executable>
